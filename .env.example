# Sao chép thành .env (cùng thư mục với menu.py). KHÔNG đưa file .env lên git.

# Key Gemini MIỄN PHÍ, nhiều key cách nhau dấu phẩy (mỗi key nên thuộc một Project khác nhau, vì quota tính theo Project)
GEMINI_API_KEYS=key1,key2,key3

# Danh sách model, model đứng trước được ưu tiên. Để trống = mặc định của process_book.py
# (3.8-flash, 3.6-flash, 3.5-flash-lite, 3.1-flash-lite, 3-flash-preview, gemma-4-31b-it).
# Xem tên hiện có: uv run process_book.py --list-models
GEMINI_MODEL=

# Key TRẢ PHÍ (Project có bật billing): chốt chặn cuối cùng, chỉ dùng khi MỌI key miễn phí đã hết quota ngày
# VÀ chạy với --allow-paid (hoặc bật mục [13] trong menu [15]). Mỗi lần chạy có trần --paid-max-pages (mặc định 300).
GEMINI_PAID_API_KEY=
# Model dùng với key trả phí (mặc định gemini-3.1-flash-lite)
GEMINI_PAID_MODEL=

# Groq Vision: dự phòng khi Gemini từ chối chép một trang vì RECITATION (Groq không có bộ lọc này).
# Nhiều key cách nhau dấu phẩy. Tạo tại https://console.groq.com/keys
GROQ_API_KEYS=
# Model Groq Vision, cách nhau dấu phẩy (tuỳ chọn; mặc định qwen/qwen3.8-27b)
GROQ_MODELS=

# Lớp biên tập văn phong (menu [17]): model riêng (tuỳ chọn; để trống thì dùng GEMINI_MODEL hoặc mặc định)
BIEN_TAP_MODEL=
# Groq model văn bản dự phòng khi Gemini từ chối biên tập (tuỳ chọn)
GROQ_TEXT_MODELS=
# Chỉ cho backend web (gemini-webapi): cookie lấy từ trình duyệt, KHÔNG đưa lên GitHub
GEMINI_SECURE_1PSID=
GEMINI_SECURE_1PSIDTS=

# DeepSeek API cho giải đề y khoa ở Step 4 (văn bản)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Giây nghỉ giữa hai request và thời gian chờ tối đa mỗi lần gọi (tuỳ chọn)
REQUEST_DELAY=6
REQUEST_TIMEOUT=180
