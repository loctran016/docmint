# Sao chép các dòng cần thiết sang file .env của toolkit (không đẩy .env lên GitHub).
GEMINI_API_KEY=
# Nhiều model cách nhau dấu phẩy: model không tồn tại hoặc hết quota ngày thì chuyển sang model kế.
# Cần khớp với process_book.py; xem tên model: uv run process_book.py --list-models
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash
# Giây nghỉ giữa hai lần gọi Gemini (slides_to_md.py, process_book.py)
REQUEST_DELAY=6
# Notebook mặc định cho các script nguồn giáo viên (hoặc dùng notebook_id.txt của toolkit)
NOTEBOOKLM_NOTEBOOK=
