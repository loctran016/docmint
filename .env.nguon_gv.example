# Sao chép các dòng cần thiết sang file .env của toolkit (không đẩy .env lên GitHub).
GEMINI_API_KEY=
# Nhiều model cách nhau dấu phẩy: model không tồn tại hoặc hết quota ngày thì chuyển sang model kế.
# Cần khớp với process_book.py; xem tên model: uv run process_book.py --list-models
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash
# Giây nghỉ giữa hai lần gọi Gemini (slides_to_md.py, process_book.py)
REQUEST_DELAY=6
# Notebook mặc định cho các script nguồn giáo viên (hoặc dùng notebook_id.txt của toolkit)
NOTEBOOKLM_NOTEBOOK=

# --- Transcript bằng Groq Whisper (input/transcripts/get_medical_transcript.py) ---
# Nhiều key cách nhau dấu phẩy; tạo tại https://console.groq.com/keys
GROQ_API_KEYS=
# Model chép giọng nói, cách nhau dấu phẩy (tuỳ chọn; mặc định whisper-large-v3 rồi whisper-large-v3-turbo)
GROQ_STT_MODELS=
# Nhiều key Gemini để làm sạch thuật ngữ (hoặc dùng GEMINI_API_KEY ở trên)
GEMINI_API_KEYS=
# Model làm sạch transcript (tuỳ chọn; để trống thì dùng GEMINI_MODEL hoặc mặc định của build_transcript.py)
TRANSCRIPT_MODEL=
# yt-dlp cho video Không công khai hoặc khi YouTube chặn IP: chọn MỘT trong hai
YT_COOKIES_BROWSER=
YT_COOKIES_FILE=
